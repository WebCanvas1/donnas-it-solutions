{
  "name": "donnas-it-solutions",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*"
    ]
  },
  "main": "worker/index.js",
  "keep_vars": true,
  "kv_namespaces": [
    {
      "binding": "SITE_CONTENT",
      "id": "26b7e92511ff475cba938db85b81a91b"
    }
  ]
}
