{
  "name": "donnas-it-solutions",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/blog",
      "/blog/*",
      "/sitemap-blog.xml",
      "/media/*",
      "/services/*",
      "/privacy-policy",
      "/terms-and-conditions"
    ]
  },
  "main": "worker/index.js",
  "keep_vars": true,
  "previews": {
    "kv_namespaces": [{ "binding": "SITE_CONTENT", "id": "321afe168acd4616af877aed8ace9e66" }]
  },
  "kv_namespaces": [
    {
      "binding": "SITE_CONTENT",
      "id": "26b7e92511ff475cba938db85b81a91b"
    }
  ]
}
