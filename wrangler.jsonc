{
  "name": "donnas-it-solutions",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/media/*",
      "/services/*",
      "/privacy-policy",
      "/terms-and-conditions"
    ]
  },
  "main": "worker/index.js",
  "keep_vars": true,
  "previews": {
    "kv_namespaces": [
      {
        "binding": "SITE_CONTENT",
        "id": "5ac7adaf01f34332b72c421d3469869f"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "SITE_CONTENT",
      "id": "26b7e92511ff475cba938db85b81a91b"
    }
  ]
}
